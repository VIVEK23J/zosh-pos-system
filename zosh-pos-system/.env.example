# ===================================================================
# ZOSH POS SYSTEM - BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ===================================================================
# Copy this file to '.env' and fill in your actual credentials.

SERVER_PORT=5000

# Database Configuration (MySQL)
DB_URL=jdbc:mysql://localhost:3306/storeSystem
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# Hibernate Settings
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true

# Razorpay Payment Gateway (Test or Live)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
RAZORPAY_CURRENCY=INR
RAZORPAY_COMPANY_NAME=ZOSH POS Retail

# JWT Security
JWT_SECRET=your_super_secret_jwt_key_at_least_256_bits_long

# Logging Level
LOG_LEVEL_WEB=DEBUG
